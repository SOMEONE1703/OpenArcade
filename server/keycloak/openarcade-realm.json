{
  "realm": "openarcade",
  "displayName": "OpenArcade",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": false,
  "rememberMe": true,
  "sslRequired": "external",
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      { "name": "player", "description": "Default role for every account" },
      { "name": "publisher", "description": "Approved game publisher" },
      { "name": "admin", "description": "OpenArcade staff" }
    ]
  },
  "defaultRole": {
    "name": "default-roles-openarcade",
    "composite": true,
    "composites": { "realm": ["player", "offline_access", "uma_authorization"] }
  },
  "clients": [
    {
      "clientId": "openarcade-web",
      "name": "OpenArcade web app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "rootUrl": "http://localhost:5173",
      "baseUrl": "/",
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "openarcade-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "openarcade-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "openarcade-api",
      "name": "OpenArcade API",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": false,
      "trustEmail": true,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "REPLACE_ME",
        "clientSecret": "REPLACE_ME",
        "syncMode": "IMPORT",
        "defaultScope": "openid profile email"
      }
    },
    {
      "alias": "discord",
      "displayName": "Discord",
      "providerId": "oidc",
      "enabled": false,
      "trustEmail": true,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "REPLACE_ME",
        "clientSecret": "REPLACE_ME",
        "authorizationUrl": "https://discord.com/oauth2/authorize",
        "tokenUrl": "https://discord.com/api/oauth2/token",
        "userInfoUrl": "https://discord.com/api/users/@me",
        "issuer": "https://discord.com",
        "jwksUrl": "https://discord.com/api/oauth2/keys",
        "defaultScope": "openid identify email",
        "clientAuthMethod": "client_secret_post",
        "validateSignature": "true",
        "useJwksUrl": "true",
        "syncMode": "IMPORT"
      }
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@openarcade.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Arcade",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "realmRoles": ["default-roles-openarcade", "admin", "publisher"]
    },
    {
      "username": "player",
      "email": "player@openarcade.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Pat",
      "lastName": "Player",
      "credentials": [{ "type": "password", "value": "player", "temporary": false }],
      "realmRoles": ["default-roles-openarcade"]
    }
  ]
}
